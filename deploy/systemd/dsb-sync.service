[Unit]
Description=Synchronize DSB schedules once
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/dsb-backend-oracle/.env

[Service]
Type=oneshot
WorkingDirectory=/opt/dsb-backend-oracle
ExecStart=/usr/bin/docker compose -f compose.yaml -f compose.production.yaml --profile sync run --rm --no-deps worker
TimeoutStartSec=4min
UMask=0077
