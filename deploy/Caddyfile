{$API_DOMAIN} {
    encode zstd gzip

    tls {
        issuer acme {
            profile shortlived
        }
    }

    handle /api/* {
        reverse_proxy api:8000
    }

    handle /healthz {
        reverse_proxy api:8000
    }

    handle {
        root * /srv/frontend
        try_files {path} {path}/ /index.html
        file_server
    }
}
