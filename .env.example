# DSB access credentials (fill only on the deployment host)
DSB_USER=
DSB_PASS=
DSB_TEACHER_USER=
DSB_TEACHER_PASS=

# Discord webhooks (optional; fill only on the deployment host)
DISCORD_WEBHOOK_WARN=
DISCORD_WEBHOOK_PLANS=
DISCORD_PING_ROLE_ID=

# Optional: publish committed plans to the separate Cloudflare read API.
# Keep the bearer token only in this host-side .env file (mode 600).
CLOUDFLARE_API_URL=
CLOUDFLARE_PUBLISH_TOKEN=

DATA_DIRECTORY=./data
DATABASE_PATH=./data/dsb.sqlite3
FRONTEND_ORIGIN=
API_DOMAIN=
